# Copy to server/.env for local development.
# In production these are set in the host dashboard (Render → Environment),
# never committed. The server refuses to start in production if any are missing.

# ---------- required in production ----------

# MongoDB Atlas connection string.
# Use a DIFFERENT database for development than for production, or local testing
# writes straight into the live shop. The name after the last '/' is the database:
#   ...mongodb.net/rijisha_dev   ← local
#   ...mongodb.net/rijisha       ← production
# Leave empty in development to use the zero-setup embedded MongoDB instead.
MONGO_URI=

# Signs login tokens. Any long random string; changing it logs everyone out.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# The admin account, created on first startup if it doesn't exist.
# There are no defaults on purpose — a fallback password in the repo would be
# public. An existing account with this email is never auto-promoted to admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Public address of the storefront, e.g. https://rijisha.in — no trailing slash.
# Password reset emails build their link from this. It is NOT taken from the
# incoming request: anyone can forge a Host header and redirect a real
# customer's reset link to their own site.
# Leave empty in development to use http://localhost:5173.
PUBLIC_URL=

# ---------- optional ----------

# ---------- email (password reset) ----------
# Leave SMTP_HOST empty and emails are printed to the server log instead of
# being sent — fine for development, where you copy the reset link out of the
# terminal. In production, an unset SMTP_HOST means customers who forget their
# password never receive anything.
#
# THIS FILE IS COMMITTED TO GIT — put real values in server/.env, never here.
#
# Brevo: smtp-relay.brevo.com / 587. SMTP_USER is the login shown on the
# Transactional → SMTP page (like 8a2f1c001@smtp-brevo.com, not your own
# address), and SMTP_PASS is an SMTP key (xsmtpsib-…), not an API key.
# Gmail: smtp.gmail.com / 587, SMTP_USER is the address, SMTP_PASS is an
# App Password (not the account password) from Google Account → Security.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# The From: address customers see, as "Display Name <address>".
# Must be an address the provider has verified for your account.
MAIL_FROM=

# Port the API listens on (Render sets this automatically).
PORT=5000

# Staging folder for in-flight uploads. Defaults to server/uploads.
# With Cloudinary configured below, files only pass through here on their way
# up and are deleted immediately, so this no longer needs to be persistent.
UPLOAD_DIR=

# ---------- image & video storage (Cloudinary) ----------
# Without these, uploads stay on this server's disk. On Render the machine is
# rebuilt from git on every deploy — and again whenever a free instance wakes
# from sleep — so those files vanish and every product image breaks.
#
# Sign up free at cloudinary.com; all three values are on the dashboard.
# After setting them, move the existing files across once with:
#   npm run migrate:uploads          (preview)
#   npm run migrate:uploads -- --go  (apply)
#
# THIS FILE IS COMMITTED TO GIT — real values belong in server/.env, never here.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Top-level folder inside Cloudinary. Defaults to "rijisha".
CLOUDINARY_FOLDER=

# Only needed if the storefront is served from a different domain than the API.
# Same-origin deployments (the default) need no CORS at all — leave empty.
CLIENT_ORIGIN=
